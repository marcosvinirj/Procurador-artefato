# Supabase — SERVIDOR APENAS. Nunca prefixar com NEXT_PUBLIC_.
# A service key ignora RLS: se vazar, o browser tem acesso total à base de dados.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Segredo do cron. Gerar com: python -c "import secrets;print(secrets.token_urlsafe(32))"
# A Vercel envia-o como `Authorization: Bearer <CRON_SECRET>` nas execuções agendadas.
CRON_SECRET=

# Opcional: conector de concorrência (Etsy API v3, app-level key).
# Sem esta chave o sinal de concorrência fica a None em vez de ser inventado.
ETSY_API_KEY=

# Opcional: segundo conector de concorrência/margem (eBay Browse API, OAuth2
# client-credentials). Usado como fallback quando o Etsy falha ou a chave
# acima não está configurada. Sem alguma destas o sinal fica a None.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
